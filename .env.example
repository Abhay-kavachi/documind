# DocuMind Environment Configuration
# Copy this file to .env.local and fill in values

# ─── Application ───
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Authentication ───
# Secret used to sign session cookies (generate a random 64-char hex string)
SESSION_SECRET=

# ─── LLM Provider ───
# Options: gemini | demo
LLM_PROVIDER=demo

# Google Gemini API Key (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# ─── Retrieval Mode ───
# Options: colpali | demo_fallback
RETRIEVAL_MODE=demo_fallback

# ColPali endpoint URL (required when RETRIEVAL_MODE=colpali)
COLPALI_ENDPOINT=

# ─── Storage ───
# Directory for uploaded files and rendered pages (relative to project root)
STORAGE_DIR=./storage

# ─── Limits ───
# Maximum upload file size in bytes (default: 50MB)
MAX_UPLOAD_SIZE=52428800

# Maximum pages to process per document
MAX_PAGES=200
